# Copy this file to backend/.env and fill in real values. Do NOT commit .env.
# Port of the API (the website runs on 5173)
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campuslink_db

# Secret used to sign the session cookie – generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-string
