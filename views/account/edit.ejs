<%- include('../partials/head') %>
<%- include('../partials/header') %>

<% const invalid = (name) => errors[name] ? `aria-invalid="true" aria-describedby="error-${name}"` : ''; %>

<main id="main" class="container section">
  <a href="/account" class="back-link">← Back to My Account</a>

  <div class="form-card form-narrow">
    <h1>Edit profile</h1>

    <%- include('../partials/errorSummary', { errors }) %>

    <form action="/account/edit" method="post" novalidate>
      <%- include('../partials/csrfField') %>

      <div class="form-field">
        <label for="field-email">Email</label>
        <input id="field-email" type="email" value="<%= profile.email %>" disabled aria-describedby="email-hint">
        <p class="field-hint" id="email-hint">Your email is used to log in and can’t be changed.</p>
      </div>

      <div class="form-field">
        <label for="field-fullName">Full name</label>
        <input id="field-fullName" name="fullName" type="text" autocomplete="name" required maxlength="100"
               value="<%= values.fullName %>" <%- invalid('fullName') %>>
        <%- include('../partials/fieldError', { errors, name: 'fullName' }) %>
      </div>

      <div class="form-field">
        <label for="field-major">Major <span class="optional">(optional)</span></label>
        <input id="field-major" name="major" type="text" maxlength="100"
               value="<%= values.major %>" <%- invalid('major') %>>
        <%- include('../partials/fieldError', { errors, name: 'major' }) %>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a href="/account" class="btn btn-ghost">Cancel</a>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
