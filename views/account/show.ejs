<%- include('../partials/head') %>
<%- include('../partials/header') %>

<%
  // "Showing 5 of 12" style note for sections that only list the most recent items
  const moreNote = (shown, total) => total > shown ? `Showing the ${shown} most recent of ${total}.` : '';
%>

<main id="main" class="container section">
  <div class="page-head">
    <div>
      <h1>My Account</h1>
      <p class="page-lead">Your profile and everything you’ve done on CampusLink.</p>
    </div>
  </div>

  <div class="detail-layout">
    <div class="detail-main-col">

      <section class="card" aria-labelledby="my-requests-title">
        <div class="section-head">
          <h2 id="my-requests-title" class="side-title">My help requests (<%= requestCount %>)</h2>
          <a href="/help/new" class="btn btn-ghost">+ New request</a>
        </div>
        <% if (requests.length === 0) { %>
          <p class="muted">You haven’t asked for help yet.</p>
        <% } else { %>
          <ul class="session-list">
            <% requests.forEach((request) => { %>
              <li>
                <a href="/help/<%= request.id %>" class="session-title"><%= request.title %></a>
                <span class="status status-<%= request.status %>"><%= constants.HELP_REQUEST_STATUSES[request.status] %></span>
                <p class="offer-meta"><%= constants.HELP_CATEGORIES[request.category] %> · <%= constants.SUPPORT_MODES[request.support_mode] %> · posted <%= formatDateTime(request.created_at) %></p>
              </li>
            <% }) %>
          </ul>
          <p class="field-hint"><%= moreNote(requests.length, requestCount) %></p>
        <% } %>
      </section>

      <section class="card" aria-labelledby="my-offers-title">
        <div class="section-head">
          <h2 id="my-offers-title" class="side-title">My offers (<%= offerCount %>)</h2>
          <% if (offerCount > 0) { %><a href="/offers">See all →</a><% } %>
        </div>
        <% if (offers.length === 0) { %>
          <p class="muted">You haven’t offered help yet. <a href="/help">Browse requests</a>.</p>
        <% } else { %>
          <ul class="session-list">
            <% offers.forEach((offer) => { %>
              <li>
                <a href="/help/<%= offer.help_request_id %>" class="session-title"><%= offer.request_title %></a>
                <span class="status status-<%= offer.status %>"><%= constants.OFFER_STATUSES[offer.status] %></span>
                <p class="offer-meta">Sent <%= formatDateTime(offer.created_at) %></p>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <section class="card" aria-labelledby="my-sessions-title">
        <div class="section-head">
          <h2 id="my-sessions-title" class="side-title">My help sessions (<%= sessionCount %>)</h2>
          <% if (sessionCount > 0) { %><a href="/sessions">See all →</a><% } %>
        </div>
        <% if (sessions.length === 0) { %>
          <p class="muted">No help sessions yet.</p>
        <% } else { %>
          <ul class="session-list">
            <% sessions.forEach((session) => { %>
              <li>
                <a href="/sessions/<%= session.id %>" class="session-title"><%= session.request_title %></a>
                <span class="status status-<%= session.status %>"><%= constants.SESSION_STATUSES[session.status] %></span>
                <p class="offer-meta">
                  <%= session.helper_user_id === currentUser.id ? `Helping ${session.requester_name}` : `Helped by ${session.helper_name}` %>
                </p>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <section class="card" aria-labelledby="my-posts-title">
        <div class="section-head">
          <h2 id="my-posts-title" class="side-title">My Lost &amp; Found posts (<%= postCount %>)</h2>
          <a href="/lost-found/new" class="btn btn-ghost">+ New post</a>
        </div>
        <% if (posts.length === 0) { %>
          <p class="muted">You haven’t posted anything.</p>
        <% } else { %>
          <ul class="session-list">
            <% posts.forEach((post) => { %>
              <li>
                <span class="lf-type lf-type-<%= post.post_type %>"><%= constants.LOST_FOUND_TYPES[post.post_type] %></span>
                <a href="/lost-found/<%= post.id %>" class="session-title"><%= post.title %></a>
                <span class="status status-lf-<%= post.status %>"><%= constants.LOST_FOUND_STATUSES[post.status] %></span>
                <p class="offer-meta">Posted <%= formatDateTime(post.created_at) %></p>
              </li>
            <% }) %>
          </ul>
          <p class="field-hint"><%= moreNote(posts.length, postCount) %></p>
        <% } %>
      </section>
    </div>

    <aside class="detail-side">
      <section class="card" aria-labelledby="profile-title">
        <h2 id="profile-title" class="side-title">Profile</h2>
        <dl class="detail-list">
          <div><dt>Full name</dt><dd><%= profile.full_name %></dd></div>
          <div><dt>Email</dt><dd><%= profile.email %></dd></div>
          <div><dt>Major</dt><dd><%= profile.major || 'Not set' %></dd></div>
          <div><dt>Member since</dt><dd><%= formatDateTime(profile.created_at) %></dd></div>
        </dl>
        <p class="field-hint">Your email is private. It’s only shown to the other person in a help session.</p>
        <a href="/account/edit" class="btn btn-primary btn-block">Edit profile</a>
      </section>

      <section class="card" aria-labelledby="my-teams-title">
        <h2 id="my-teams-title" class="side-title">My teams (<%= teams.length %>)</h2>
        <% if (teams.length === 0) { %>
          <p class="muted">You haven’t joined a team. <a href="/teams">Find one</a>.</p>
        <% } else { %>
          <ul class="member-list">
            <% teams.forEach((team) => { %>
              <li>
                <div>
                  <a href="/teams/<%= team.id %>" class="session-title"><%= team.name %></a>
                  <p class="offer-meta"><%= team.member_count %> member<%= team.member_count === 1 ? '' : 's' %></p>
                </div>
                <% if (team.owner_user_id === currentUser.id) { %><span class="status status-scheduled">Owner</span><% } %>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>
    </aside>
  </div>
</main>

<%- include('../partials/footer') %>
