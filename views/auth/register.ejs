<%- include('../partials/head') %>
<%- include('../partials/header') %>

<%
  // aria attributes that mark a field as invalid and point to its error message
  const invalid = (name) => errors[name] ? `aria-invalid="true" aria-describedby="error-${name}"` : '';
%>

<main id="main" class="container section">
  <div class="form-card form-narrow">
    <h1>Create your account</h1>
    <p class="muted">Join CampusLink to ask for help, offer help and join study teams.</p>

    <%- include('../partials/errorSummary', { errors }) %>

    <form action="/register" method="post" novalidate>
      <%- include('../partials/csrfField') %>
      <input type="hidden" name="returnTo" value="<%= returnTo %>">

      <div class="form-field">
        <label for="field-fullName">Full name</label>
        <input id="field-fullName" name="fullName" type="text" autocomplete="name" required maxlength="100"
               value="<%= values.fullName || '' %>" <%- invalid('fullName') %>>
        <%- include('../partials/fieldError', { errors, name: 'fullName' }) %>
      </div>

      <div class="form-field">
        <label for="field-email">Email</label>
        <input id="field-email" name="email" type="email" autocomplete="email" required maxlength="255"
               value="<%= values.email || '' %>" <%- invalid('email') %>>
        <%- include('../partials/fieldError', { errors, name: 'email' }) %>
      </div>

      <div class="form-field">
        <label for="field-major">Major <span class="optional">(optional)</span></label>
        <input id="field-major" name="major" type="text" maxlength="100"
               value="<%= values.major || '' %>" <%- invalid('major') %>>
        <%- include('../partials/fieldError', { errors, name: 'major' }) %>
      </div>

      <div class="form-field">
        <label for="field-password">Password</label>
        <input id="field-password" name="password" type="password" autocomplete="new-password" required minlength="8"
               aria-describedby="password-hint<%= errors.password ? ' error-password' : '' %>"
               <%- errors.password ? 'aria-invalid="true"' : '' %>>
        <p class="field-hint" id="password-hint">At least 8 characters.</p>
        <%- include('../partials/fieldError', { errors, name: 'password' }) %>
      </div>

      <div class="form-field">
        <label for="field-confirmPassword">Confirm password</label>
        <input id="field-confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required
               <%- invalid('confirmPassword') %>>
        <%- include('../partials/fieldError', { errors, name: 'confirmPassword' }) %>
      </div>

      <button type="submit" class="btn btn-primary btn-block">Sign up</button>
    </form>

    <p class="form-footer">
      Already have an account?
      <a href="/login<%= returnTo ? '?returnTo=' + encodeURIComponent(returnTo) : '' %>">Log in</a>
    </p>
  </div>
</main>

<%- include('../partials/footer') %>
