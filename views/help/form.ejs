<%- include('../partials/head') %>
<%- include('../partials/header') %>

<%
  // Same form for creating (request = null) and editing (request = current row)
  const isEdit = Boolean(request);
  const action = isEdit ? `/help/${request.id}/edit` : '/help';
  const invalid = (name) => errors[name] ? `aria-invalid="true" aria-describedby="error-${name}"` : '';
%>

<main id="main" class="container section">
  <a href="<%= isEdit ? `/help/${request.id}` : '/help' %>" class="back-link">← <%= isEdit ? 'Back to request' : 'Back to help requests' %></a>

  <div class="form-card">
    <h1><%= pageTitle %></h1>
    <p class="muted">Don’t include your phone number, home address or other private details.</p>

    <%- include('../partials/errorSummary', { errors }) %>

    <form action="<%= action %>" method="post" novalidate class="help-form"
          <% if (isEdit) { %>data-original-mode="<%= request.support_mode %>"<% } %>>
      <%- include('../partials/csrfField') %>

      <div class="form-field">
        <label for="field-title">Title</label>
        <input id="field-title" name="title" type="text" required minlength="5" maxlength="150"
               value="<%= values.title || '' %>" placeholder="e.g. Need help with recursion in Python" <%- invalid('title') %>>
        <%- include('../partials/fieldError', { errors, name: 'title' }) %>
      </div>

      <div class="form-field">
        <label for="field-description">Description</label>
        <textarea id="field-description" name="description" rows="6" required minlength="10" maxlength="5000"
                  placeholder="What do you need help with? What have you tried so far?" <%- invalid('description') %>><%= values.description || '' %></textarea>
        <%- include('../partials/fieldError', { errors, name: 'description' }) %>
      </div>

      <div class="form-row">
        <div class="form-field">
          <label for="field-category">Category</label>
          <select id="field-category" name="category" required <%- invalid('category') %>>
            <option value="">Choose a category</option>
            <% Object.entries(constants.HELP_CATEGORIES).forEach(([value, label]) => { %>
              <option value="<%= value %>" <%= values.category === value ? 'selected' : '' %>><%= label %></option>
            <% }) %>
          </select>
          <%- include('../partials/fieldError', { errors, name: 'category' }) %>
        </div>

        <div class="form-field">
          <label for="field-scheduledAt">When <span class="optional">(optional)</span></label>
          <input id="field-scheduledAt" name="scheduledAt" type="datetime-local"
                 value="<%= values.scheduledAt || '' %>" <% if (!isEdit) { %>min="<%= minDateTime %>"<% } %> <%- invalid('scheduledAt') %>>
          <%- include('../partials/fieldError', { errors, name: 'scheduledAt' }) %>
        </div>
      </div>

      <fieldset class="form-field" id="field-supportMode" <%- errors.supportMode ? 'aria-describedby="error-supportMode"' : '' %>>
        <legend>Support type</legend>
        <div class="radio-group">
          <% Object.entries(constants.SUPPORT_MODES).forEach(([value, label]) => { %>
            <label class="radio">
              <input type="radio" name="supportMode" value="<%= value %>" <%= values.supportMode === value ? 'checked' : '' %>>
              <%= label %>
            </label>
          <% }) %>
        </div>
        <%- include('../partials/fieldError', { errors, name: 'supportMode' }) %>
      </fieldset>

      <div class="form-field" data-show-when-mode="in_person">
        <label for="field-locationLabel">General location <span class="optional">(optional, in person only)</span></label>
        <input id="field-locationLabel" name="locationLabel" type="text" maxlength="150"
               value="<%= values.locationLabel || '' %>" placeholder="e.g. Library, 2nd floor" <%- invalid('locationLabel') %>>
        <%- include('../partials/fieldError', { errors, name: 'locationLabel' }) %>
      </div>

      <% if (isEdit) { %>
        <div class="form-field confirm-box" data-mode-change-confirm>
          <label class="checkbox" for="field-confirmModeChange">
            <input id="field-confirmModeChange" name="confirmModeChange" type="checkbox" value="yes"
                   <%- invalid('confirmModeChange') %>>
            <span>I confirm I want to change the support type
            (currently <strong><%= constants.SUPPORT_MODES[request.support_mode] %></strong>).</span>
          </label>
          <%- include('../partials/fieldError', { errors, name: 'confirmModeChange' }) %>
        </div>
      <% } %>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= isEdit ? 'Save changes' : 'Post request' %></button>
        <a href="<%= isEdit ? `/help/${request.id}` : '/help' %>" class="btn btn-ghost">Cancel</a>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
