<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main" class="container section">
  <div class="page-head">
    <div>
      <h1>Find Help</h1>
      <p class="page-lead">Browse requests from other students and offer help where you can.</p>
    </div>
    <a href="/help/new" class="btn btn-primary">+ Post a help request</a>
  </div>

  <form class="filter-bar" action="/help" method="get" role="search" aria-label="Search and filter help requests">
    <div class="field field-wide">
      <label for="filter-q">Keyword</label>
      <input id="filter-q" type="search" name="q" value="<%= filters.q %>" maxlength="100" placeholder="Title or description…">
    </div>

    <div class="field">
      <label for="filter-category">Category</label>
      <select id="filter-category" name="category">
        <option value="">All categories</option>
        <% Object.entries(constants.HELP_CATEGORIES).forEach(([value, label]) => { %>
          <option value="<%= value %>" <%= filters.category === value ? 'selected' : '' %>><%= label %></option>
        <% }) %>
      </select>
    </div>

    <div class="field">
      <label for="filter-mode">Support type</label>
      <select id="filter-mode" name="mode">
        <option value="">Any</option>
        <% Object.entries(constants.SUPPORT_MODES).forEach(([value, label]) => { %>
          <option value="<%= value %>" <%= filters.mode === value ? 'selected' : '' %>><%= label %></option>
        <% }) %>
      </select>
    </div>

    <div class="field">
      <label for="filter-status">Status</label>
      <select id="filter-status" name="status">
        <% Object.entries(constants.HELP_REQUEST_STATUSES).forEach(([value, label]) => { %>
          <option value="<%= value %>" <%= filters.status === value ? 'selected' : '' %>><%= label %></option>
        <% }) %>
        <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All statuses</option>
      </select>
    </div>

    <div class="field">
      <label for="filter-sort">Sort by</label>
      <select id="filter-sort" name="sort">
        <% Object.entries(sortOptions).forEach(([value, label]) => { %>
          <option value="<%= value %>" <%= filters.sort === value ? 'selected' : '' %>><%= label %></option>
        <% }) %>
      </select>
    </div>

    <div class="filter-actions">
      <button type="submit" class="btn btn-primary">Apply</button>
      <% if (hasActiveFilters) { %>
        <a href="/help" class="btn btn-ghost">Clear filters</a>
      <% } %>
    </div>
  </form>

  <% if (total === 0) { %>
    <div class="empty-state">
      <p>No help requests match your search.</p>
      <% if (hasActiveFilters) { %>
        <a href="/help" class="btn btn-ghost">Clear filters</a>
      <% } %>
    </div>
  <% } else { %>
    <p class="result-count" aria-live="polite">
      Showing <%= (page - 1) * pageSize + 1 %>–<%= Math.min(page * pageSize, total) %> of <%= total %> request<%= total === 1 ? '' : 's' %>
    </p>

    <div class="card-grid">
      <% requests.forEach((request) => { %>
        <%- include('../partials/helpRequestCard', { request, headingLevel: 'h2' }) %>
      <% }) %>
    </div>

    <%- include('../partials/pagination') %>
  <% } %>
</main>

<%- include('../partials/footer') %>
