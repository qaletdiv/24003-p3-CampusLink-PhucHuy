<%- include('../partials/head') %>
<%- include('../partials/header') %>

<%
  // Status buttons the owner can use, depending on the current status
  const statusActions = {
    open: [
      { status: 'resolved', label: 'Mark as resolved', className: 'btn-primary' },
      { status: 'closed', label: 'Close without resolving', className: 'btn-ghost' },
    ],
    resolved: [{ status: 'open', label: 'Reopen post', className: 'btn-ghost' }],
    closed: [{ status: 'open', label: 'Reopen post', className: 'btn-ghost' }],
  }[post.status];
%>

<main id="main" class="container section">
  <a href="/lost-found" class="back-link">← Back to Lost &amp; Found</a>

  <div class="detail-layout">
    <article class="detail-main card">
      <div class="card-tags">
        <span class="lf-type lf-type-<%= post.post_type %>"><%= constants.LOST_FOUND_TYPES[post.post_type] %></span>
        <span class="tag tag-muted"><%= constants.LOST_FOUND_CATEGORIES[post.category] %></span>
        <span class="status status-lf-<%= post.status %>"><%= constants.LOST_FOUND_STATUSES[post.status] %></span>
      </div>
      <h1 class="detail-title"><%= post.title %></h1>
      <p class="detail-posted">Posted by <%= post.author_name %> · <%= formatDateTime(post.created_at) %></p>

      <% if (post.image_url) { %>
        <%# no-referrer: the image host doesn't learn which page the viewer came from %>
        <img class="lf-image" src="<%= post.image_url %>" alt="Photo of: <%= post.title %>" loading="lazy" referrerpolicy="no-referrer">
      <% } %>

      <h2 class="sr-only">Description</h2>
      <div class="detail-description"><%= post.description %></div>

      <p class="safety-note">
        <strong>Before handing anything over:</strong> ask the other person to describe the item or show proof that it’s theirs.
        CampusLink can’t verify ownership.
      </p>
    </article>

    <aside class="detail-side">
      <section class="card" aria-labelledby="details-title">
        <h2 id="details-title" class="side-title">Details</h2>
        <dl class="detail-list">
          <div><dt>Where</dt><dd><%= post.location_label %></dd></div>
          <div>
            <dt><%= post.post_type === 'lost' ? 'Lost on' : 'Found on' %></dt>
            <dd><%= post.occurred_at ? formatDateTime(post.occurred_at) : 'Not specified' %></dd>
          </div>
          <div><dt>Status</dt><dd><%= constants.LOST_FOUND_STATUSES[post.status] %></dd></div>
        </dl>
      </section>

      <section class="card" aria-labelledby="contact-title">
        <h2 id="contact-title" class="side-title">Contact</h2>
        <% if (post.contact_info) { %>
          <p class="contact-info"><%= post.contact_info %></p>
          <p class="field-hint">Shared by the poster on purpose.</p>
        <% } else { %>
          <p class="muted">The poster didn’t share contact details. Check back later, or look for a notice at the location.</p>
        <% } %>
      </section>

      <% if (isOwner) { %>
        <section class="card" aria-labelledby="manage-title">
          <h2 id="manage-title" class="side-title">Your post</h2>
          <div class="stack">
            <% if (post.status === 'open') { %>
              <a href="/lost-found/<%= post.id %>/edit" class="btn btn-primary btn-block">Edit post</a>
            <% } %>
            <% statusActions.forEach((action) => { %>
              <form action="/lost-found/<%= post.id %>/status" method="post">
                <%- include('../partials/csrfField') %>
                <input type="hidden" name="status" value="<%= action.status %>">
                <button type="submit" class="btn <%= action.className %> btn-block"><%= action.label %></button>
              </form>
            <% }) %>
          </div>
        </section>
      <% } %>
    </aside>
  </div>
</main>

<%- include('../partials/footer') %>
