<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main" class="container section">
  <div class="page-head">
    <div>
      <h1>My offers</h1>
      <p class="page-lead">Offers you’ve sent to help other students.</p>
    </div>
    <a href="/help" class="btn btn-ghost">Find requests to help with</a>
  </div>

  <% if (offers.length === 0) { %>
    <div class="empty-state">
      <p>You haven’t offered help yet.</p>
      <a href="/help" class="btn btn-primary">Browse help requests</a>
    </div>
  <% } else { %>
    <ul class="offer-list">
      <% offers.forEach((offer) => { %>
        <li class="card offer-card">
          <div class="offer-head">
            <p class="offer-name"><a href="/help/<%= offer.help_request_id %>"><%= offer.request_title %></a></p>
            <span class="status status-<%= offer.status %>"><%= constants.OFFER_STATUSES[offer.status] %></span>
          </div>
          <p class="offer-meta">
            Sent <%= formatDateTime(offer.created_at) %>
            · You offered <strong><%= constants.SUPPORT_MODES[offer.preferred_mode] %></strong>
            · Request is <%= constants.HELP_REQUEST_STATUSES[offer.request_status] %>
          </p>
          <p class="offer-message"><%= truncate(offer.message, 200) %></p>
          <% if (offer.status === 'pending') { %>
            <form action="/offers/<%= offer.id %>/withdraw" method="post" data-confirm="Withdraw your offer?">
              <%- include('../partials/csrfField') %>
              <button type="submit" class="btn btn-ghost">Withdraw</button>
            </form>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</main>

<%- include('../partials/footer') %>
