<%# Lists all form errors at the top, each linking to its field (inputs use id="field-<name>"). Expects: errors %>
<% const errorEntries = Object.entries(errors || {}); %>
<% if (errorEntries.length > 0) { %>
  <div class="error-summary" role="alert" tabindex="-1">
    <p class="error-summary-title">Please fix the following:</p>
    <ul>
      <% errorEntries.forEach(([field, message]) => { %>
        <li><a href="#field-<%= field %>"><%= message %></a></li>
      <% }) %>
    </ul>
  </div>
<% } %>
