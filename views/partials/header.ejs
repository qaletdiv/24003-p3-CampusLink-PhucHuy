<%
  const navLinks = [
    { href: '/', label: 'Home' },
    { href: '/help', label: 'Find Help' },
    { href: '/teams', label: 'Study Teams' },
    { href: '/lost-found', label: 'Lost & Found' },
  ];
  // `locals.x` is used so this partial still renders if an error happens before x is set
  const path = locals.currentPath || '';
  const user = locals.currentUser;
  const isActive = (href) => href === '/' ? path === '/' : path.startsWith(href);
%>
<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="/"><span class="logo-mark" aria-hidden="true">CL</span> CampusLink</a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Open menu</span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main navigation">
      <ul class="nav-links">
        <% navLinks.forEach((link) => { %>
          <li>
            <a href="<%= link.href %>" <% if (isActive(link.href)) { %>class="active" aria-current="page"<% } %>><%= link.label %></a>
          </li>
        <% }) %>
      </ul>

      <div class="account-area">
        <% if (user) { %>
          <a href="/offers" class="account-link <%= isActive('/offers') ? 'active' : '' %>">My offers</a>
          <a href="/sessions" class="account-link <%= isActive('/sessions') ? 'active' : '' %>">Sessions</a>
          <a href="/account" class="account-name" title="My Account"><%= user.fullName %></a>
          <% if (locals.csrfToken) { %>
            <form action="/logout" method="post">
              <%- include('csrfField') %>
              <button type="submit" class="btn btn-ghost">Log out</button>
            </form>
          <% } %>
        <% } else { %>
          <a href="/login" class="btn btn-ghost">Log in</a>
          <a href="/register" class="btn btn-primary">Sign up</a>
        <% } %>
      </div>
    </nav>
  </div>
</header>

<% if (locals.flash) { %>
  <div class="container">
    <p class="flash flash-<%= flash.type %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>"><%= flash.message %></p>
  </div>
<% } %>
