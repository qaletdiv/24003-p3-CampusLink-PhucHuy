<%# After a cancelled help session, the request owner reopens or cancels the request. Expects: requestId %>
<p class="muted">The help session was cancelled. What would you like to do with your request?</p>
<div class="stack">
  <form action="/help/<%= requestId %>/reopen" method="post">
    <%- include('csrfField') %>
    <button type="submit" class="btn btn-primary btn-block">Reopen to find another helper</button>
  </form>
  <form action="/help/<%= requestId %>/cancel" method="post"
        data-confirm="Cancel this help request? People will no longer be able to offer help.">
    <%- include('csrfField') %>
    <button type="submit" class="btn btn-danger btn-block">Cancel the request</button>
  </form>
</div>
