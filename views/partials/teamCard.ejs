<%# Card for one team. Expects: team, isMember (boolean) %>
<% const heading = locals.headingLevel || 'h3'; // h2 on list pages, h3 inside a section %>
<article class="card">
  <div class="card-tags">
    <span class="tag"><%= team.member_count %> member<%= team.member_count === 1 ? '' : 's' %></span>
    <% if (team.upcoming_count > 0) { %>
      <span class="tag tag-muted"><%= team.upcoming_count %> upcoming session<%= team.upcoming_count === 1 ? '' : 's' %></span>
    <% } %>
    <% if (isMember) { %><span class="status status-accepted">Member</span><% } %>
  </div>
  <<%= heading %> class="card-title"><a href="/teams/<%= team.id %>"><%= team.name %></a></<%= heading %>>
  <p class="card-text"><%= truncate(team.description, 120) %></p>
  <dl class="card-meta">
    <div><dt>Owner</dt><dd><%= team.owner_name %></dd></div>
  </dl>
</article>
