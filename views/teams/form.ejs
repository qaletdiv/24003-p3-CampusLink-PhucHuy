<%- include('../partials/head') %>
<%- include('../partials/header') %>

<%
  const isEdit = Boolean(team);
  const backUrl = isEdit ? `/teams/${team.id}` : '/teams';
  const invalid = (name) => errors[name] ? `aria-invalid="true" aria-describedby="error-${name}"` : '';
%>

<main id="main" class="container section">
  <a href="<%= backUrl %>" class="back-link">← <%= isEdit ? 'Back to team' : 'Back to teams' %></a>

  <div class="form-card">
    <h1><%= pageTitle %></h1>
    <% if (!isEdit) { %><p class="muted">You’ll be the team owner and its first member.</p><% } %>

    <%- include('../partials/errorSummary', { errors }) %>

    <form action="<%= isEdit ? `/teams/${team.id}/edit` : '/teams' %>" method="post" novalidate>
      <%- include('../partials/csrfField') %>

      <div class="form-field">
        <label for="field-name">Team name</label>
        <input id="field-name" name="name" type="text" required minlength="3" maxlength="100"
               value="<%= values.name || '' %>" placeholder="e.g. Data Structures Study Group" <%- invalid('name') %>>
        <%- include('../partials/fieldError', { errors, name: 'name' }) %>
      </div>

      <div class="form-field">
        <label for="field-description">Description</label>
        <textarea id="field-description" name="description" rows="5" required minlength="10" maxlength="1000"
                  placeholder="What does the team do? When and where do you usually meet?" <%- invalid('description') %>><%= values.description || '' %></textarea>
        <%- include('../partials/fieldError', { errors, name: 'description' }) %>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= isEdit ? 'Save changes' : 'Create team' %></button>
        <a href="<%= backUrl %>" class="btn btn-ghost">Cancel</a>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
