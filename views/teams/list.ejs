<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main" class="container section">
  <div class="page-head">
    <div>
      <h1>Study Teams</h1>
      <p class="page-lead">Find a group to study with, or start your own. All teams are open to join.</p>
    </div>
    <a href="/teams/new" class="btn btn-primary">+ Create a team</a>
  </div>

  <form class="search-inline" action="/teams" method="get" role="search">
    <label for="team-search" class="sr-only">Search teams</label>
    <input id="team-search" type="search" name="q" value="<%= q %>" maxlength="100" placeholder="Search by name or description…">
    <button type="submit" class="btn btn-primary">Search</button>
    <% if (q) { %><a href="/teams" class="btn btn-ghost">Clear</a><% } %>
  </form>

  <% if (total === 0) { %>
    <div class="empty-state">
      <p><%= q ? 'No teams match your search.' : 'No teams yet. Be the first to create one!' %></p>
      <% if (q) { %><a href="/teams" class="btn btn-ghost">Show all teams</a><% } %>
    </div>
  <% } else { %>
    <p class="result-count" aria-live="polite">
      Showing <%= (page - 1) * pageSize + 1 %>–<%= Math.min(page * pageSize, total) %> of <%= total %> team<%= total === 1 ? '' : 's' %>
    </p>

    <div class="card-grid">
      <% teams.forEach((team) => { %>
        <%- include('../partials/teamCard', { team, isMember: myTeamIds.has(team.id), headingLevel: 'h2' }) %>
      <% }) %>
    </div>

    <%- include('../partials/pagination') %>
  <% } %>
</main>

<%- include('../partials/footer') %>
