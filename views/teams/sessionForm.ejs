<%- include('../partials/head') %>
<%- include('../partials/header') %>

<%
  const isEdit = Boolean(session);
  const backUrl = isEdit ? `/teams/${team.id}/sessions/${session.id}` : `/teams/${team.id}`;
  const invalid = (name) => errors[name] ? `aria-invalid="true" aria-describedby="error-${name}"` : '';
%>

<main id="main" class="container section">
  <a href="<%= backUrl %>" class="back-link">← Back</a>

  <div class="form-card">
    <h1><%= pageTitle %></h1>
    <p class="muted">For <strong><%= team.name %></strong>. Only team members can see it.</p>

    <%- include('../partials/errorSummary', { errors }) %>

    <form action="<%= isEdit ? `/teams/${team.id}/sessions/${session.id}/edit` : `/teams/${team.id}/sessions` %>" method="post" novalidate>
      <%- include('../partials/csrfField') %>

      <div class="form-field">
        <label for="field-title">Title</label>
        <input id="field-title" name="title" type="text" required minlength="3" maxlength="150"
               value="<%= values.title || '' %>" placeholder="e.g. Exam review session" <%- invalid('title') %>>
        <%- include('../partials/fieldError', { errors, name: 'title' }) %>
      </div>

      <div class="form-field">
        <label for="field-description">Description <span class="optional">(optional)</span></label>
        <textarea id="field-description" name="description" rows="4" maxlength="2000" <%- invalid('description') %>><%= values.description || '' %></textarea>
        <%- include('../partials/fieldError', { errors, name: 'description' }) %>
      </div>

      <div class="form-row">
        <div class="form-field">
          <label for="field-startsAt">Starts</label>
          <input id="field-startsAt" name="startsAt" type="datetime-local" required
                 value="<%= values.startsAt || '' %>" <% if (!isEdit) { %>min="<%= minDateTime %>"<% } %> <%- invalid('startsAt') %>>
          <%- include('../partials/fieldError', { errors, name: 'startsAt' }) %>
        </div>
        <div class="form-field">
          <label for="field-endsAt">Ends</label>
          <input id="field-endsAt" name="endsAt" type="datetime-local" required
                 value="<%= values.endsAt || '' %>" <%- invalid('endsAt') %>>
          <%- include('../partials/fieldError', { errors, name: 'endsAt' }) %>
        </div>
      </div>

      <div class="form-field">
        <label for="field-locationLabel">General location <span class="optional">(optional)</span></label>
        <input id="field-locationLabel" name="locationLabel" type="text" maxlength="150"
               value="<%= values.locationLabel || '' %>" placeholder="e.g. Library, group room 3" <%- invalid('locationLabel') %>>
        <%- include('../partials/fieldError', { errors, name: 'locationLabel' }) %>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= isEdit ? 'Save changes' : 'Create session' %></button>
        <a href="<%= backUrl %>" class="btn btn-ghost">Cancel</a>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
